# Copy this file to a secret manager or a deployment-only .env file.
# Never commit real passwords, SMTP credentials, OAuth secrets, or encryption keys.

# Public endpoints. TLS terminates at your trusted reverse proxy.
NODE_ENV=production
WEB_ORIGIN=https://app.example.com
WEB_ALLOWED_ORIGINS=
NEXT_PUBLIC_API_URL=https://api.example.com
COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax
TRUST_PROXY=1

# Keep service ports private. The reverse proxy is the only public entry point.
API_PORT=4000
WEB_PORT=3001
PROXY_PORT=8080

# PostgreSQL: use distinct, strong passwords and replace every placeholder.
POSTGRES_DB=devflow
POSTGRES_USER=devflow_admin
POSTGRES_PASSWORD=replace-with-a-unique-bootstrap-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-unique-migrator-password
POSTGRES_RUNTIME_PASSWORD=replace-with-a-unique-runtime-password
DOCKER_MIGRATION_DATABASE_URL=postgres://devflow_migrator:replace-with-a-unique-migrator-password@postgres:5432/devflow
DOCKER_RUNTIME_DATABASE_URL=postgres://devflow_runtime:replace-with-a-unique-runtime-password@postgres:5432/devflow
DB_POOL_MAX=10

# Redis runs within the Compose network.
REDIS_PORT=6380
DOCKER_REDIS_URL=redis://redis:6379

# A real SMTP provider is mandatory in production; Mailpit is development-only.
SMTP_FROM=DevFlow <no-reply@example.com>
DOCKER_SMTP_HOST=smtp.example.com
DOCKER_SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password

# Sessions, rate limiting and lifecycle.
SESSION_COOKIE_NAME=devflow_session
SESSION_TTL_DAYS=30
SESSION_CLEANUP_INTERVAL_HOURS=24
INVITATION_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=1000
SHUTDOWN_TIMEOUT_MS=10000
E2E_TEST_MODE=false

# Generate once with: openssl rand -base64 32
# Keep it unchanged while encrypted AI and Figma credentials must remain readable.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Configure all three Figma values together, or leave all three empty.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=https://api.example.com/api/v1/integrations/figma/callback
