# Application
NODE_ENV=development
E2E_TEST_MODE=false
API_PORT=4000
WEB_PORT=3001
PROXY_PORT=8080
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://127.0.0.1:3001
# Optional comma-separated additional browser origins, for example localhost.
WEB_ALLOWED_ORIGINS=http://localhost:3001

# PostgreSQL bootstrap account and least-privilege application roles.
# Use three distinct passwords outside local development.
POSTGRES_DB=devflow
POSTGRES_USER=devflow_admin
POSTGRES_PASSWORD=replace-with-a-unique-bootstrap-password
POSTGRES_MIGRATOR_PASSWORD=replace-with-a-unique-migrator-password
POSTGRES_RUNTIME_PASSWORD=replace-with-a-unique-runtime-password
DATABASE_MIGRATION_URL=postgres://devflow_migrator:replace-with-a-unique-migrator-password@localhost:5432/devflow
DATABASE_URL=postgres://devflow_runtime:replace-with-a-unique-runtime-password@localhost:5432/devflow
DATABASE_ADMIN_URL=postgres://devflow_admin:replace-with-a-unique-bootstrap-password@localhost:5432/postgres
TEST_DATABASE_URL=postgres://devflow_runtime:replace-with-a-unique-runtime-password@localhost:5432/devflow_test
TEST_MIGRATION_DATABASE_URL=postgres://devflow_migrator:replace-with-a-unique-migrator-password@localhost:5432/devflow_test
DOCKER_RUNTIME_DATABASE_URL=postgres://devflow_runtime:replace-with-a-unique-runtime-password@postgres:5432/devflow
DOCKER_MIGRATION_DATABASE_URL=postgres://devflow_migrator:replace-with-a-unique-migrator-password@postgres:5432/devflow
DB_POOL_MAX=10

# Redis
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
DOCKER_REDIS_URL=redis://redis:6379

# Local Mailpit. Replace these values with an SMTP provider in production.
SMTP_FROM=DevFlow <no-reply@devflow.local>
SMTP_HOST=localhost
SMTP_PORT=1025
DOCKER_SMTP_HOST=mailpit
DOCKER_SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAILPIT_WEB_URL=http://localhost:8025

# Sessions and security
SESSION_COOKIE_NAME=devflow_session
SESSION_TTL_DAYS=30
SESSION_CLEANUP_INTERVAL_HOURS=24
SESSION_COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true # Required in production.
# TRUST_PROXY=1 # Set only behind one trusted reverse proxy.
SHUTDOWN_TIMEOUT_MS=10000

# Invitations, account recovery, and rate limiting
INVITATION_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=1000

# Uploaded profile avatars and project icons live in a persistent Docker volume.
# Override this path only when running the API outside Docker.
UPLOADS_DIR=uploads
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://127.0.0.1:4000/api/v1/integrations/figma/callback
# GitHub and GitLab OAuth apps are optional. Configure either provider to enable it.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:4000/api/v1/integrations/git/github/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=http://127.0.0.1:4000/api/v1/integrations/git/gitlab/callback
# Public API base URL used later for provider webhooks, for example https://api.example.com
INTEGRATION_WEBHOOK_URL=
INTEGRATION_ENCRYPTION_KEY=
