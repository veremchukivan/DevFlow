NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=postgres://devflow:replace-with-a-unique-local-password@localhost:5432/devflow
DOCKER_DATABASE_URL=postgres://devflow:replace-with-a-unique-local-password@postgres:5432/devflow
TEST_DATABASE_URL=postgres://devflow:replace-with-a-unique-local-password@localhost:5432/devflow_test
DATABASE_ADMIN_URL=postgres://devflow:replace-with-a-unique-local-password@localhost:5432/postgres

# Database pool
DB_POOL_MAX=10

# Sessions
SESSION_COOKIE_NAME=devflow_session
SESSION_TTL_DAYS=30

# Invitations
INVITATION_TTL_DAYS=7

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=1000
