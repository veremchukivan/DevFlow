{
  "name": "devflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "turbo build",
    "db:generate": "pnpm --filter @devflow/api db:generate",
    "db:migrate": "pnpm --filter @devflow/api db:migrate",
    "db:push": "pnpm --filter @devflow/api db:push",
    "db:studio": "pnpm --filter @devflow/api db:studio",
    "dev": "pnpm --filter @devflow/shared build && turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}

