{
  "name": "devflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.30"
    }
  },
  "scripts": {
    "build": "turbo build",
    "db:generate": "pnpm --filter @devflow/api db:generate",
    "db:migrate": "pnpm --filter @devflow/api db:migrate",
    "db:push": "pnpm --filter @devflow/api db:push",
    "db:studio": "pnpm --filter @devflow/api db:studio",
    "db:test:prepare": "pnpm --filter @devflow/api db:test:prepare",
    "dev": "pnpm --filter @devflow/shared build && turbo dev",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "infra:up:integrations": "docker compose --env-file .env -f infra/docker/docker-compose.yml --profile integrations up -d --build",
    "infra:up:proxy": "docker compose --env-file .env -f infra/docker/docker-compose.yml --profile proxy up -d --build",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d --build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}

